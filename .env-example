# How to get your private key from MetaMask:
# 1. Open MetaMask
# 2. Click the three dots (⋮) next to your account name
# 3. Select "Account details"
# 4. Click "Show private key"
# 5. Enter your MetaMask password to reveal it
# 6. Copy the private key and paste it below
#
# MetaMask uses the same private key for all EVM chains (Ethereum, Base, etc.),
# so you can use the same key for both ETH_PRIVATE_KEY and BASE_PRIVATE_KEY.
#
# NEVER share your private key or commit .env to git.

# Private key for Ethereum (source chain)
ETH_PRIVATE_KEY=your_private_key_here

# Private key for Base (destination chain) — can be the same as above
BASE_PRIVATE_KEY=your_private_key_here
